# =============================================================================
# AI-Ready School — environment settings
#
# Copy this file to .env.local and fill in the values:
#     cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real keys.
# See docs/SETUP.md for where each value comes from.
# =============================================================================

# --- Supabase (accounts + database + file storage) ---------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — bypasses row-level security. Server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) -------------------------------------------------------
# Use TEST mode keys (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs (start with price_...) for the two products.
STRIPE_PRICE_TEACHER_KIT=
STRIPE_PRICE_SCHOOL_LICENSE=

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
# Until you verify your own domain, the default sender works for testing.
EMAIL_FROM="AI-Ready School <onboarding@resend.dev>"

# --- Site ---------------------------------------------------------------------
# Must be an absolute URL including https:// — Stripe checkout and Supabase auth
# redirects are built from this and will fail without the scheme.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# This email becomes the Owner (full admin) when you run `npm run seed`.
OWNER_EMAIL=
