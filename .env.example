# =============================================================================
# AI-Ready School — environment variables
# Copy to .env.local for local dev; set the same in Vercel for deploys.
# The site runs fine with NONE of these set (marketing pages only).
# =============================================================================

# ---- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon / public key
SUPABASE_SERVICE_ROLE_KEY=           # service_role key (SECRET — server only)

# ---- Stripe (Developers → API keys; use the SANDBOX/test keys first) --------
STRIPE_SECRET_KEY=                   # sk_test_...
STRIPE_WEBHOOK_SECRET=               # whsec_... (from scripts/setup-stripe.mjs or Stripe CLI)
STRIPE_PRICE_SCHOOL=                 # price_... ($1,499/yr) — setup script creates + prints
STRIPE_PRICE_INDIVIDUAL=             # price_... ($99/yr)   — setup script creates + prints

# ---- Resend (optional for testing; invites fall back to copyable links) -----
RESEND_API_KEY=                      # re_...
EMAIL_FROM=AI-Ready School <onboarding@resend.dev>   # until a domain is verified
OWNER_EMAIL=                         # where quote requests are sent

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # set to the deploy URL on Vercel
